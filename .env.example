# Epistemic Pipeline — Environment Variables
# Copy to .env and fill in values

# OpenAI (required)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Server
PORT=8000

# Pipeline URL (used by n8n to reach the API service)
# On Railway: set to the internal service URL, e.g. http://api.railway.internal:8000
PIPELINE_URL=http://localhost:8000
