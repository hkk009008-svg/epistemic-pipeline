# Epistemic Pipeline — Environment Variables
# Copy to .env and fill in values

# OpenAI (required)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Tavily web search (optional)
TAVILY_API_KEY=tvly-...

# Server
PORT=8000
RATE_LIMIT_PER_MINUTE=20

# Security — set in production to protect config endpoints
# When set, config-mutation endpoints require Authorization: Bearer <ADMIN_TOKEN>
# This includes: POST /api/openai/config, /api/tavily/config, /api/stage/config,
# /v2/admin/config
ADMIN_TOKEN=

# Allowed base URL prefixes for stage config (comma-separated)
# Stage configs with base_url not matching these prefixes are rejected.
# Defaults: localhost, openrouter.ai, api.openai.com, api.anthropic.com
# ALLOWED_BASE_URLS=https://my-proxy.example.com/

# CORS — comma-separated allowed origins (empty = same-origin only)
ALLOWED_ORIGINS=

# HSTS — set to "true" on Railway/HTTPS deployments
FORCE_HTTPS=false

# Dev only — set to "true" to allow system prompt overrides via API
ALLOW_PROMPT_OVERRIDE=false

# Pipeline URL (used by n8n to reach the API service)
# On Railway: set to the internal service URL, e.g. http://api.railway.internal:8000
PIPELINE_URL=http://localhost:8000

# Per-stage model config (optional, can also be set via UI)
# GPT1_PROVIDER=openai
# GPT1_MODEL=gpt-4o
# GPT1_API_KEY=
# GPT2_PROVIDER=openai
# GPT2_MODEL=gpt-4o-mini
# GPT2_API_KEY=
# GPT3_PROVIDER=openai
# GPT3_MODEL=gpt-4o-mini
# GPT3_API_KEY=

# NLI microservice (optional)
# NLI_SERVICE_URL=

# Anthropic (if using Claude for any stage)
# ANTHROPIC_API_KEY=sk-ant-...
