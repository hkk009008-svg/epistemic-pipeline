{
  "id": "6rURf0fICupXbIj2",
  "name": "ECA — Stress Test (Webhook → Summary)",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "eca-stress",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "eca-sw-0001-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "eca-sw-0001-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.PIPELINE_BASE_URL || 'http://localhost:8000') + '/api/stress' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ category: ($json.body && $json.body.category) || null, count: ($json.body && $json.body.count) || null }) }}",
        "options": {
          "timeout": 600000,
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "eca-sw-0002-stress",
      "name": "Run Stress Test",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.data || '';\nconst lines = String(raw).split('\\n').filter(line => line.trim());\nlet summary = null;\nfor (const line of lines) {\n  try {\n    const obj = JSON.parse(line);\n    if (obj.type === 'summary') { summary = obj; break; }\n  } catch (e) { /* skip non-JSON lines */ }\n}\nif (!summary) {\n  return [{ json: { error: 'No summary found in stress response', raw_line_count: lines.length } }];\n}\nreturn [{ json: summary }];"
      },
      "id": "eca-sw-0003-parse",
      "name": "Extract Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "rs1",
              "name": "type",
              "value": "={{ $json.type }}",
              "type": "string"
            },
            {
              "id": "rs2",
              "name": "summary",
              "value": "={{ JSON.stringify($json) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "eca-sw-0004-return",
      "name": "Return Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Run Stress Test",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Stress Test": {
      "main": [
        [
          {
            "node": "Extract Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Summary": {
      "main": [
        [
          {
            "node": "Return Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  },
  "triggerCount": 1,
  "tags": []
}
